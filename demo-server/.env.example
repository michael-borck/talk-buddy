# Copy to .env on the VPS and fill in — never commit the real .env.

# LLM (Ollama):
OLLAMA_URL=http://127.0.0.1:11434
# The bearer key for your Ollama (leave empty if it has none):
OLLAMA_KEY=
# Must match `ollama list` exactly:
OLLAMA_MODEL=gemma4

# Speech-to-text: the stt container in compose.yaml runs Speaches locally.
# Inside the compose network, containers reach each other by service name on
# the CONTAINER's port (Speaches listens on 8000 inside).
SPEECH_URL=http://stt:8000
SPEECH_DIALECT=openai
SPEECH_KEY=
SPEECH_MODEL=Systran/faster-whisper-small

# The only browser origin allowed to call the proxy:
ALLOWED_ORIGIN=https://talkbuddy.borck.education
PORT=8787
# Per IP per rolling hour:
RATE_LIMIT_PER_HOUR=30
TRANSCRIBE_RATE_LIMIT_PER_HOUR=60
