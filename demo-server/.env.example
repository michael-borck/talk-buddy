# Copy to .env on the VPS and fill in — never commit the real .env.

# LLM (Ollama):
OLLAMA_URL=http://127.0.0.1:11434
# The bearer key for your Ollama (leave empty if it has none):
OLLAMA_KEY=
# Must match `ollama list` exactly:
OLLAMA_MODEL=gemma4

# Speech-to-text: two dialects are supported.
#   SPEECH_DIALECT=openai    → OpenAI-compatible (Speaches, whisper-fastapi):
#                              POST {SPEECH_URL}/v1/audio/transcriptions
#   SPEECH_DIALECT=voicebox  → jamiepine/voicebox: POST {SPEECH_URL}/transcribe
SPEECH_URL=https://speaches.example.com
SPEECH_DIALECT=openai
SPEECH_KEY=
# openai default: Systran/faster-whisper-small · voicebox default: whisper-turbo
SPEECH_MODEL=Systran/faster-whisper-small

# The only browser origin allowed to call the proxy:
ALLOWED_ORIGIN=https://talkbuddy.borck.education
PORT=8787
# Per IP per rolling hour:
RATE_LIMIT_PER_HOUR=30
TRANSCRIBE_RATE_LIMIT_PER_HOUR=60
